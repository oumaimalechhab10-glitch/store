<section class="section section--tight">
  <div class="shell">
    <div class="page-content page-content--narrow" style="max-width:420px">
      <h1 class="display-3 center">Nouveau mot de passe</h1>
      {% form 'reset_customer_password', class: 'contact-form', style: 'margin-top:26px' %}
        {{ form.errors | default_errors }}
        <div><label class="label" for="ResetPassword">Mot de passe</label><input class="input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password"></div>
        <div><label class="label" for="ResetConfirm">Confirmation</label><input class="input" type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password"></div>
        <button type="submit" class="btn btn--dark btn--full">Valider</button>
      {% endform %}
    </div>
  </div>
</section>
