{%- comment -%}
  Default Shopify rules, plus explicit permission for AI crawlers.
  Being readable by assistants was an explicit requirement: these agents
  check robots.txt before they will quote a page.
{%- endcomment -%}
{%- for group in robots.default_groups -%}
{{- group.user_agent }}
{% for rule in group.rules -%}
{{ rule }}
{% endfor -%}
{%- if group.sitemap != blank -%}
{{ group.sitemap }}
{% endif -%}
{%- endfor -%}

