{%- comment -%}
  Flag for a language option.

  A flag is a country, not a language, so the mapping is an editorial choice
  rather than a lookup: Arabic is shown with Morocco because this shop sells
  only in Morocco, French with France and English with the United States.
  Anything else falls back to the uppercase language code, which is why the
  picker still reads correctly if a fourth language is published.

  Usage: {% render 'flag', code: language.iso_code %}
{%- endcomment -%}
{%- assign c = code | split: '-' | first | downcase -%}
{%- case c -%}
  {%- when 'ar' -%}
    <svg class="flag" viewBox="0 0 20 14" width="20" height="14" role="img" aria-hidden="true" focusable="false">
      <rect width="20" height="14" fill="#c1272d"/>
      <path d="M10 3 12.35 10.24 6.2 5.76h7.6L7.65 10.24Z"
            fill="none" stroke="#006233" stroke-width=".9" stroke-linejoin="round"/>
    </svg>
  {%- when 'fr' -%}
    <svg class="flag" viewBox="0 0 20 14" width="20" height="14" role="img" aria-hidden="true" focusable="false">
      <rect width="20" height="14" fill="#f5f5f5"/>
      <rect width="6.67" height="14" fill="#002395"/>
      <rect x="13.33" width="6.67" height="14" fill="#ed2939"/>
    </svg>
  {%- when 'en' -%}
    <svg class="flag" viewBox="0 0 20 14" width="20" height="14" role="img" aria-hidden="true" focusable="false">
      <rect width="20" height="14" fill="#f5f5f5"/>
      <g fill="#b22234">
        <rect width="20" height="1.08" y="0"/>
        <rect width="20" height="1.08" y="2.15"/>
        <rect width="20" height="1.08" y="4.31"/>
        <rect width="20" height="1.08" y="6.46"/>
        <rect width="20" height="1.08" y="8.62"/>
        <rect width="20" height="1.08" y="10.77"/>
        <rect width="20" height="1.08" y="12.92"/>
      </g>
      <rect width="8.4" height="7.54" fill="#3c3b6e"/>
      <g fill="#fff">
        <circle cx="1.5" cy="1.3" r=".42"/><circle cx="3.9" cy="1.3" r=".42"/>
        <circle cx="6.3" cy="1.3" r=".42"/><circle cx="2.7" cy="2.8" r=".42"/>
        <circle cx="5.1" cy="2.8" r=".42"/><circle cx="1.5" cy="4.3" r=".42"/>
        <circle cx="3.9" cy="4.3" r=".42"/><circle cx="6.3" cy="4.3" r=".42"/>
        <circle cx="2.7" cy="5.8" r=".42"/><circle cx="5.1" cy="5.8" r=".42"/>
      </g>
    </svg>
  {%- else -%}
    <span class="flag flag--code" aria-hidden="true">{{ c | upcase }}</span>
{%- endcase -%}
