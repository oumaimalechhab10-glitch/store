<div class="shell">{% render 'breadcrumbs' %}</div>

<article class="section section--tight">
  <div class="shell">
    <header class="page-head center">
      <p class="eyebrow">{{ article.published_at | date: '%d %B %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
      <h1 class="display-2" style="margin-top:12px">{{ article.title }}</h1>
    </header>

    {%- if article.image and section.settings.show_image -%}
      <div class="collection-banner" style="margin-top:30px">
        <img src="{{ article.image | image_url: width: 2000 }}" alt="{{ article.image.alt | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}" fetchpriority="high">
      </div>
    {%- endif -%}

    <div class="rte page-content page-content--narrow">{{ article.content }}</div>

    {%- if blog.next_article or blog.previous_article -%}
      <nav class="pagination" style="margin-top:50px">
        {%- if blog.previous_article -%}<a href="{{ blog.previous_article.url }}" class="pagination__link">{{ 'general.previous' | t }}</a>{%- endif -%}
        <a href="{{ blog.url }}" class="pagination__link">{{ blog.title }}</a>
        {%- if blog.next_article -%}<a href="{{ blog.next_article.url }}" class="pagination__link">{{ 'general.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "class": "main-article-section",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Show featured image", "default": true }
  ]
}
{% endschema %}
