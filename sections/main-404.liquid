{%- comment -%} translated defaults {%- endcomment -%}
{%- liquid
  assign tkey = template.name
  if template.suffix != blank
    assign tkey = tkey | append: '_' | append: template.suffix
  endif
  assign ns = 'defaults.' | append: tkey | append: '_' | append: section.id
  assign d_title = section.settings.title
  if d_title == blank
    assign _t = ns | append: '.title' | t
    unless _t contains 'translation missing'
      assign d_title = _t
    endunless
  endif
-%}
<section class="section">
  <div class="shell center">
    <p class="eyebrow">{{ 'general.error_404' | t }}</p>
    <h1 class="display-1" style="margin-top:14px">{{ 'general.not_found_title' | t }}</h1>
    <p class="lead" style="max-width:48ch;margin:16px auto 0">{{ 'general.not_found_text' | t }}</p>

    <div class="hero__actions" style="justify-content:center; margin-top:30px">
      <a href="{{ routes.root_url }}" class="btn btn--dark">{{ 'general.home' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">{{ 'collections.all' | t }}</a>
    </div>

    {%- if section.settings.collection != blank -%}
      <div style="margin-top: clamp(48px,6vw,80px); text-align:left">
        <div class="section-head center">
          <h2 class="section-title">{{ d_title }}</h2>
        </div>
        <div class="product-grid product-grid--4">
          {%- for product in section.settings.collection.products limit: 4 -%}
            {% render 'product-card', product: product, index: forloop.index %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "404",
  "class": "main-404-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ]
}
{% endschema %}
