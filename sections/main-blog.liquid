{%- comment -%} translated defaults {%- endcomment -%}
{%- liquid
  assign tkey = template.name
  if template.suffix != blank
    assign tkey = tkey | append: '_' | append: template.suffix
  endif
  assign ns = 'defaults.' | append: tkey | append: '_' | append: section.id
  assign d_empty_text = section.settings.empty_text
  if d_empty_text == blank
    assign _t = ns | append: '.empty_text' | t
    unless _t contains 'translation missing'
      assign d_empty_text = _t
    endunless
  endif
  assign d_eyebrow = section.settings.eyebrow
  if d_eyebrow == blank
    assign _t = ns | append: '.eyebrow' | t
    unless _t contains 'translation missing'
      assign d_eyebrow = _t
    endunless
  endif
-%}
{%- paginate blog.articles by 12 -%}

<div class="shell">{% render 'breadcrumbs' %}</div>

<section class="section section--tight">
  <div class="shell">
    <div class="section-head center">
      <p class="eyebrow">{{ d_eyebrow }}</p>
      <h1 class="display-2" style="margin-top:12px">{{ blog.title }}</h1>
    </div>

    {%- if blog.articles_count > 0 -%}
      <div class="product-grid product-grid--3">
        {%- for article in blog.articles -%}
          <article class="card card--collection reveal">
            <a href="{{ article.url }}" class="card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div class="card__body">
              <p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p>
              <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="small muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state"><p class="display-3">{{ d_empty_text }}</p></div>
    {%- endif -%}
  </div>
</section>

{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "class": "main-blog-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "" }
  ]
}
{% endschema %}
