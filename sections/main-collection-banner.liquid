<div class="shell">
  {% render 'breadcrumbs' %}
</div>

<section class="section section--tight">
  <div class="shell">
    <div class="collection-head">
      {%- if section.settings.show_eyebrow -%}
        <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
      {%- endif -%}
      <h1 class="display-2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte lead collection-head__text">{{ collection.description }}</div>
      {%- endif -%}
      <p class="small muted" style="margin-top:14px">
        {{ 'collections.product_count' | t: count: collection.products_count }}
      </p>
    </div>

    {%- if section.settings.show_image and collection.image -%}
      <div class="collection-banner">
        <img
          src="{{ collection.image | image_url: width: 2000 }}"
          srcset="{{ collection.image | image_url: width: 900 }} 900w, {{ collection.image | image_url: width: 1600 }} 1600w, {{ collection.image | image_url: width: 2200 }} 2200w"
          sizes="100vw"
          alt="{{ collection.image.alt | default: collection.title | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
          fetchpriority="high">
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "class": "collection-banner-section",
  "settings": [
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": true }
  ]
}
{% endschema %}
