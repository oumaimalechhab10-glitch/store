{%- comment -%} translated defaults {%- endcomment -%}
{%- liquid
  assign tkey = template.name
  if template.suffix != blank
    assign tkey = tkey | append: '_' | append: template.suffix
  endif
  assign ns = 'defaults.' | append: tkey | append: '_' | append: section.id
  assign d_subtitle = section.settings.subtitle
  if d_subtitle == blank
    assign _t = ns | append: '.subtitle' | t
    unless _t contains 'translation missing'
      assign d_subtitle = _t
    endunless
  endif
  assign d_title = section.settings.title
  if d_title == blank
    assign _t = ns | append: '.title' | t
    unless _t contains 'translation missing'
      assign d_title = _t
    endunless
  endif
-%}
<section class="section">
  <div class="shell">
    {%- if d_title != blank -%}
      <div class="section-head center">
        <h2 class="section-title">{{ d_title }}</h2>
        {%- if d_subtitle != blank -%}<p>{{ d_subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-grid{% if section.blocks.size >= 6 %} collection-grid--6{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a class="collection-card reveal" href="{{ col.url | default: block.settings.link }}" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: col.featured_image -%}
          {%- if img -%}
            <img
              src="{{ img | image_url: width: 600 }}"
              srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 600 }} 600w"
              sizes="(max-width: 767px) 50vw, 16vw"
              alt="{{ col.title | default: block.settings.label | escape }}"
              loading="lazy"
              width="{{ img.width }}"
              height="{{ img.height }}">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}

          <span class="collection-card__label">
            <strong>{{ block.settings.label | default: col.title }}</strong>
            {%- if col != blank -%}
              <span>{{ 'collections.product_count' | t: count: col.products_count }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "class": "collection-list-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "" },
    { "type": "text", "id": "subtitle", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "item" }, { "type": "item" }, { "type": "item" },
        { "type": "item" }, { "type": "item" }, { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
